    <string name="string_162">Accessible Video Editor is a comprehensive media editing tool designed with accessibility in mind. It supports 11 languages and offers professional features such as video merging, text customization, smart cutting, and more.</string>
    <string name="string_163">Version 1.0.0</string>
    <string name="string_164">Developed by Accessibility First Team</string>
