    <string name="string_176">Welcome to the Accessible Video Editor.</string>
    <string name="string_177">- Video Editor: Edit videos, trim, and add text or watermarks.</string>
    <string name="string_178">- Image Editor: Add text, shapes, and filters to images.</string>
    <string name="string_179">- Smart Cut: Automatically remove silence from audio or video.</string>
    <string name="string_180">- Ticker Text: Add moving news-style ticker text to videos.</string>
    <string name="string_181">Navigate using the main menu. All buttons are labeled for screen readers.</string>
