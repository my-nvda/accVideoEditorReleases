<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="الوصف الصوتي التفاعلي للمكفوفين"
        app:titleTextColor="?attr/colorOnPrimary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Model Status & Download Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorContainer"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvModelStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="حالة النموذج: جاري الفحص..."
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="تنزيل حزمة محرك الوصف الصوتي (10 MB)"
                        android:visibility="gone"
                        app:icon="@android:drawable/stat_sys_download" />

                    <ProgressBar
                        android:id="@+id/pbModelDownload"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectVideo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="اختيار فيديو لإضافة وصف صوتي مشاهد"
                app:icon="@android:drawable/ic_menu_gallery" />

            <TextView
                android:id="@+id/tvSelectedVideo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الفيديو المختار: لم يتم اختيار فيديو"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerateAudioDescription"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="توليد الوصف الصوتي وسرد مشاهد المشاهدين"
                app:icon="@android:drawable/ic_media_play" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
