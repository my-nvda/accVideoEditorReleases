<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/topAppBar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="?attr/colorPrimary" app:title="@string/title_background_music" app:titleTextColor="?attr/colorOnPrimary" app:navigationIcon="@android:drawable/ic_menu_revert" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <Button android:id="@+id/btnSelectMainMedia" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/string_47" android:minHeight="48dp" />
            <TextView android:id="@+id/tvMainMediaFile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
            <Button android:id="@+id/btnSelectBgMusic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/string_19" android:minHeight="48dp" />
            <TextView android:id="@+id/tvBgMusicFile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
            <TextView android:id="@+id/lblBgVolume" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/label_bg_volume" android:textSize="16sp" android:textStyle="bold" android:labelFor="@id/spinnerBgVolume" />
            <Spinner android:id="@+id/spinnerBgVolume" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:contentDescription="@string/label_bg_volume" />
            <Button android:id="@+id/btnApply" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/btn_apply" android:minHeight="48dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>