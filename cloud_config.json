    "btnBatchProcess": "\u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062c\u0645\u0627\u0639\u064a\u0629 \u0644\u0644\u0645\u0644\u0641\u0627\u062a",
    "btnSpeedControl": "\u062a\u063a\u064a\u064a\u0631 \u0633\u0631\u0639\u0629 \u0627\u0644\u062a\u0634\u063a\u064a\u0644",
