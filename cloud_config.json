  "allAvailableFeatureIds": {
    "btnVideoEditor": "\u0645\u062d\u0631\u0631 \u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0627\u0644\u0634\u0627\u0645\u0644",
