    "btnWatermark": "\u0625\u0636\u0627\u0641\u0629 \u0639\u0644\u0627\u0645\u0629 \u0645\u0627\u0626\u064a\u0629 \u0648\u0646\u0635\u0648\u0635",
    "btnCreateBlankImage": "\u0625\u0646\u0634\u0627\u0621 \u0635\u0648\u0631\u0629 \u0645\u0644\u0648\u0646\u0629 \u0641\u0627\u0631\u063a\u0629",
    "btnVideoTrimmer": "\u0642\u0635 \u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0627\u0644\u0645\u062d\u062f\u062f",
    "btnSmartCut": "\u0627\u0644\u0642\u0635 \u0627\u0644\u0630\u0643\u064a \u0644\u0644\u0635\u0645\u062a \u0648\u0627\u0644\u0647\u062f\u0648\u0621",
    "btnAudioEditor": "\u0645\u062d\u0631\u0631 \u0627\u0644\u0635\u0648\u062a\u064a\u0627\u062a \u0648\u0627\u0644\u062a\u0623\u062b\u064a\u0631\u0627\u062a",
    "btnAudioStudio": "\u0627\u0633\u062a\u0648\u062f\u064a\u0648 \u0627\u0644\u0647\u0646\u062f\u0633\u0629 \u0627\u0644\u0635\u0648\u062a\u064a\u0629",
    "btnAiAnalysis": "\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0641\u064a\u062f\u064a\u0648\u0647\u0627\u062a \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a",
    "btnStt": "\u0627\u0644\u062a\u0641\u0631\u064a\u063a \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0644\u0644\u0635\u0648\u062a \u0625\u0644\u0649 \u0646\u0635",
    "btnOcr": "\u0642\u0631\u0627\u0621\u0629 \u0648\u062a\u0641\u0631\u064a\u063a \u0627\u0644\u0646\u0635\u0648\u0635 \u0645\u0646 \u0627\u0644\u0635\u0648\u0631 OCR",
    "btnFastConverter": "\u0627\u0644\u0645\u062d\u0648\u0644 \u0627\u0644\u0633\u0631\u064a\u0639 \u0644\u0635\u064a\u063a \u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0648\u0627\u0644\u0635\u0648\u062a",
    "btnBoostVolume": "\u062a\u0636\u062e\u064a\u0645 \u0648\u0631\u0641\u0639 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0635\u0648\u062a",
    "btnExtractAudio": "\u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0627\u0644\u0635\u0648\u062a \u0645\u0646 \u0627\u0644\u0641\u064a\u062f\u064a\u0648",
    "btnCompressVideo": "\u062a\u0642\u0644\u064a\u0644 \u0648\u062d\u062c\u0645 \u0648\u0636\u063a\u0637 \u0627\u0644\u0641\u064a\u062f\u064a\u0648",
    "btnMergeVideos": "\u062f\u0645\u062c \u0627\u0644\u0641\u064a\u062f\u064a\u0648\u0647\u0627\u062a \u0648\u062a\u0623\u062b\u064a\u0631\u0627\u062a \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644",
    "btnReverseMedia": "\u0639\u0643\u0633 \u0627\u062a\u062c\u0627\u0647 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0648\u0627\u0644\u0635\u0648\u062a",
    "btnSlideshowMaker": "\u0635\u0627\u0646\u0639 \u0627\u0644\u0639\u0631\u0648\u0636 \u0648\u0627\u0644\u0634\u0631\u0627\u0626\u062d \u0645\u0646 \u0627\u0644\u0635\u0648\u0631",
